    {
      "parameters": {
        "jsCode": "// TODO: Parser específico para el newsletter de LinkedIn Jobs\n// Extrae del HTML del email:\n// - titulo: texto del link principal\n// - url: href del link (limpiar tracking params)\n// - empleador: nombre de la empresa\n// - descripcion: texto del snippet\n// - ubicacion: si está disponible\n// - categoria: inferir del título/descripción\n\nconst html = $input.item.json.html || $input.item.json.textHtml || $input.item.json.body;\n\n// Placeholder — ajustar con emails reales\nconst jobs = [];\n\n// Ejemplo de estructura esperada:\n// jobs.push({\n//   titulo: 'Desarrollador Full Stack',\n//   url: 'https://www.linkedin.com/jobs/view/12345',\n//   empleador: 'Empresa XYZ',\n//   descripcion: 'Buscamos desarrollador con experiencia en...',\n//   ubicacion: 'Santiago, Chile',\n//   categoria: 'Full Stack'\n// });\n\nreturn jobs.map(j => ({ json: j }));"
      },
      "id": "parser",
      "name": "Parser HTML → Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO pegas (url, titulo, empleador, descripcion, categoria, ubicacion, fecha_publicacion, fuente, email_origen)\nVALUES ($1, $2, $3, $4, $5, $6, NOW(), 'linkedin', $7)\nON CONFLICT (url) DO NOTHING\nRETURNING id",
        "additionalFields": {}
      },
      "id": "pg-insert",
      "name": "PostgreSQL INSERT",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "exists"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-inserted",
      "name": "¿Pega nueva?",
