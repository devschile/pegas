# Copiar a .env.local para desarrollo (Nuxt lo carga automaticamente).
# Nunca commitear .env.local ni valores reales.

# Postgres: mismos nombres planos que usan n8n y scripts/ en la raiz del
# monorepo (ver server/utils/db.ts).
PGHOST=localhost
PGPORT=5432
PGDATABASE=pega
PGUSER=pega
PGPASSWORD=pega

# nuxt-auth-utils: sesion sellada. Generar con `openssl rand -base64 32`.
NUXT_SESSION_PASSWORD=

# OAuth (fase 2). Callbacks a registrar:
#   http://localhost:3000/auth/github  (Slack exige HTTPS incluso en dev)
#   https://pegas.devschile.cl/auth/{github,slack}  (produccion)
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_SLACK_CLIENT_ID=
NUXT_OAUTH_SLACK_CLIENT_SECRET=
